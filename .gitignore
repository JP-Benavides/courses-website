# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist/

# misc
.DS_Store
*.pem
*.key
/.auth/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.*.example

# vercel
.vercel

# local Cloudflare tooling
/.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# installed agent/editor tooling (keep root AGENTS.md and CLAUDE.md tracked)
/.agents/
/.claude/
/.codex/
/.cursor/

# local design previews, generated mocks, and tool session state
/.impeccable/

# temporary files and browser-test output
/tmp/
/playwright-report/
/test-results/
.eslintcache

# typescript
*.tsbuildinfo
next-env.d.ts
