NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Full public HTTPS MCP endpoint ending in /mcp. Leave unset until deployed.
# NEXT_PUBLIC_MCP_URL=https://your-mcp-host/mcp

# Server only. Required for account deletion. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
